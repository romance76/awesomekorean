APP_NAME=AwesomeKorean
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://awesomekorean.com
APP_TIMEZONE=America/New_York
APP_LOCALE=ko
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=awesomekorean
DB_USERNAME=awesomekorean_user
DB_PASSWORD=
BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
JWT_SECRET=
REVERB_APP_ID=awesomekorean_app
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=awesomekorean.com
REVERB_PORT=443
REVERB_SCHEME=https
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# 부동산 매물 자동 수집용 (realtyapi.io 가입 후 발급받은 키). 비워두면 realestate:scrape가
# 아무것도 하지 않고 조용히 스킵함.
REALTYAPI_KEY=
# 중고장터 자동 수집용 (developer.ebay.com 가입 후 발급받은 Production Client ID/Secret,
# Browse API용). 둘 중 하나라도 비워두면 market:scrape가 조용히 스킵함.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# '정보' 탭 자동 생성 파이프라인 전용 인증 토큰 (POST /api/info-ingest/* 호출 시
# Authorization: Bearer <값>으로 사용). 비워두면 ingest.auth 미들웨어가 전부 401 처리.
INFO_INGEST_TOKEN=
# 쇼핑(Amazon Associates 제휴) 태그. affiliate-program.amazon.com에서 발급받은
# 자신의 Associate ID를 넣으면 됨. 비워두면 config/services.php의 기본값
# (awesomekorean-20)이 사용됨.
AMAZON_ASSOCIATE_TAG=awesomekorean-20
